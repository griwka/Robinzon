; Engine configuration file.
; Открывать в Godot 4.5+ (стандартная версия, не .NET)

config_version=5

[application]

config/name="Затерянный остров"
config/description="Уютная выживалка на тропическом острове: собирай, крафти, строй."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
textures/canvas_textures/default_texture_filter=3
textures/default_filters/anisotropic_filtering_level=4

[shader_globals]

g_sun_dir={
"type": "vec3",
"value": Vector3(0.3, 0.8, 0.5)
}
g_player_pos={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
g_wind={
"type": "float",
"value": 1.0
}
g_light={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
g_cloud_lit={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
g_cloud_shade={
"type": "vec3",
"value": Vector3(0.55, 0.62, 0.85)
}
g_rain={
"type": "float",
"value": 0.0
}
